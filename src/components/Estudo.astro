---
import { paragrafos, subsecoes } from '../lib/conteudo';

const titulo = 'O que a gente já viu do Eklesia e do InPeace';
const grupos = subsecoes(titulo);
const intro = paragrafos(grupos[0].blocos).map((linhas) => linhas.join(' '));
const apps = grupos
  .filter((g) => g.titulo === 'Eklesia' || g.titulo === 'InPeace')
  .map((g) => {
    const ps = paragrafos(g.blocos).map((linhas) => linhas.join(' '));
    return { nome: g.titulo as string, abertura: ps[0], corpo: ps.slice(1, -1), preferencia: ps[ps.length - 1] };
  });
const conclusao = grupos.find((g) => g.titulo === 'O que eu tirei disso');
const [ideia, fonte] = conclusao ? paragrafos(conclusao.blocos).map((linhas) => linhas.join(' ')) : ['', ''];
---

<section class="secao estudo" id="o-que-vimos" aria-labelledby="estudo-titulo">
  <header class="grade estudo-topo">
    <h2 class="titulo-secao estudo-titulo" id="estudo-titulo">{titulo}</h2>
    <div class="texto estudo-intro">
      {intro.map((p) => <p>{p}</p>)}
    </div>
  </header>

  <div class="estudo-apps">
    {
      apps.map((app) => (
        <article class="app" aria-labelledby={`app-${app.nome}`}>
          <h3 class="app-nome" id={`app-${app.nome}`}>
            {app.nome}
          </h3>
          <p class="app-abertura">{app.abertura}</p>
          <div class="texto app-corpo">
            {app.corpo.map((p) => (
              <p>{p}</p>
            ))}
          </div>
          <p class="citacao app-preferencia">{app.preferencia}</p>
        </article>
      ))
    }
  </div>

  <div class="grade estudo-conclusao">
    <p class="citacao estudo-ideia">{ideia}</p>
    <p class="estudo-fonte">{fonte}</p>
  </div>
</section>

<style>
  .estudo-topo {
    row-gap: var(--s-4);
    align-items: end;
  }

  .estudo-titulo {
    grid-column: 1 / span 8;
    align-self: start;
  }

  .estudo-intro {
    grid-column: 9 / span 4;
    color: var(--ink-soft);
  }

  .estudo-apps {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: var(--s-7);
    border-top: 1px solid var(--ink);
  }

  .app {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: 0;
    padding: var(--s-5) var(--s-5) 0 0;
  }

  .app + .app {
    padding-left: var(--s-5);
    padding-right: 0;
    border-left: 1px solid var(--ink);
  }

  .app-nome {
    margin: 0 0 0.32em;
    font-family: var(--serif);
    font-weight: 400;
    font-size: var(--t-mega);
    line-height: 0.88;
    letter-spacing: -0.035em;
  }

  .app-abertura {
    margin: 0 0 1.4em;
    max-width: 22em;
    font-family: var(--serif);
    font-size: var(--t-m);
    line-height: 1.3;
    text-wrap: pretty;
  }

  .app-corpo {
    margin-bottom: var(--s-4);
  }

  .app-preferencia {
    margin-top: 0;
    padding-top: 0.7em;
    border-top: 1px solid var(--ink);
  }

  .estudo-conclusao {
    margin-top: var(--s-6);
    row-gap: var(--s-3);
  }

  .estudo-ideia {
    grid-column: 2 / span 10;
    font-size: var(--t-xl);
    line-height: 1.04;
    text-align: center;
  }

  .estudo-fonte {
    grid-column: 4 / span 6;
    margin: 0;
    font-size: var(--t-small);
    line-height: 1.5;
    text-align: center;
    color: var(--ink-soft);
  }

  @media (max-width: 860px) {
    .estudo-titulo,
    .estudo-intro,
    .estudo-ideia,
    .estudo-fonte {
      grid-column: 1 / -1;
    }

    .estudo-apps {
      grid-template-columns: 1fr;
    }

    .app,
    .app + .app {
      padding: var(--s-5) 0 var(--s-6);
      border-left: 0;
    }

    .app + .app {
      border-top: 1px solid var(--ink);
    }

    .estudo-ideia {
      text-align: left;
      font-size: var(--t-l);
    }

    .estudo-fonte {
      text-align: left;
    }
  }
</style>
